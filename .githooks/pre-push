#!/bin/sh
# Checks every commit about to be pushed: author, committer, message.
. "$(dirname "$0")/_check.sh"
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"            # new branch: only commits no remote has
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  check_range $range || status=1
done
if [ "$status" -ne 0 ]; then
  echo "Push blocked. Fix authorship (see CLAUDE.md Rule 0), then push again." >&2
  exit 1
fi
