# Copy to .env (never commit .env). Fill in the empty values.

# --- AWS / Bedrock ---------------------------------------------------------
AWS_REGION=ap-south-1
# Option A (simplest): a Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=
# Option B: IAM user keys (leave empty if you use option A; setting both is an error)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Models (see docs/SPEC.md section 2)
BEDROCK_CHAT_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_JUDGE_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024
# Titan allows 60 requests per minute on a new account; 1 per second stays under it.
EMBED_REQUESTS_PER_SECOND=1

# --- Mode ------------------------------------------------------------------
# replay = use recorded model answers (offline, free); fake = scripted test model;
# bedrock = real calls (only used with --live).
GUARDRAILS_LLM_MODE=replay

# --- Safety ----------------------------------------------------------------
# Hard stop for live Bedrock spend across the whole project, in USD.
LIVE_BUDGET_USD=5
# Salt used to hash identifiers in logs (any random string; never reuse a real secret).
LOG_HASH_SALT=
